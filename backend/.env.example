PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_resource_sharing

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin bootstrap account (created automatically on first run if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@campus.edu
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# CORS - comma separated list of allowed origins, or * for all
CLIENT_ORIGIN=*

VITE_API_URL=http://localhost:5000/api
